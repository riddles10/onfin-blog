---
/**
 * Blog landing page — list of every published article, newest first.
 *
 * Data comes from Hygraph's public CDN (see `src/lib/cms.ts`). Articles
 * are authored in English; non-English locales render the English body
 * with `isFallback: true`. The listing still renders under every locale
 * prefix so hreflang alternates remain valid.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { listPublishedPosts } from "~/lib/cms";
import { LOCALES, t, localizedPath, type Locale } from "~/lib/i18n";

export const prerender = true;

export async function getStaticPaths() {
  return Promise.all(
    LOCALES.map(async (lang) => ({
      params: { lang },
      props: { posts: await listPublishedPosts(lang as Locale, { limit: 500 }) },
    })),
  );
}

const { lang } = Astro.params;
const locale = lang as Locale;
const { posts } = Astro.props;

function formatDate(iso: string | null, loc: Locale): string {
  if (!iso) return "";
  // Accept either "YYYY-MM-DD" or an ISO timestamp.
  const d = iso.length === 10 ? new Date(iso + "T00:00:00Z") : new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const BCP47: Record<Locale, string> = {
    en: "en-US",
    ru: "ru-RU",
    vi: "vi-VN",
    th: "th-TH",
    ms: "ms-MY",
    id: "id-ID",
    es: "es-419",
    zh: "zh-Hans",
  };
  return new Intl.DateTimeFormat(BCP47[loc], {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(d);
}

function toExcerpt(html: string, max = 180): string {
  const plain = html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
  if (plain.length <= max) return plain;
  const clipped = plain.slice(0, max);
  const lastSpace = clipped.lastIndexOf(" ");
  return (lastSpace > 80 ? clipped.slice(0, lastSpace) : clipped).trim() + "…";
}
---

<BaseLayout
  locale={locale}
  title="Blog — OnFin"
  description="Market updates, company news, and trading guides from OnFin."
  canonicalPath="/blog"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[#0b0b0b]">
    <div
      class="pointer-events-none absolute -right-40 top-1/2 h-[30rem] w-[30rem] -translate-y-1/2 rounded-full bg-brand-lime/15 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -left-40 bottom-0 h-96 w-96 rounded-full bg-brand-lime/10 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="container-site relative py-20 sm:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.25em] text-brand-lime">
          {t(locale, "nav.blog")}
        </p>
        <h1 class="font-display text-4xl font-semibold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Market updates & company news
        </h1>
        <p class="mt-6 text-base text-white/70 sm:text-lg">
          Trading schedules, bonus offers, maintenance notices and announcements
          from the OnFin team.
        </p>
      </div>
    </div>
  </section>

  <!-- Article list -->
  <section class="container-site py-16 sm:py-20">
    <ul class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2">
      {posts.map((post) => (
        <li>
          <a
            href={localizedPath(locale, `/blog/${post.slug}`)}
            class="group flex h-full flex-col rounded-2xl border border-ink-100 bg-white p-6 transition hover:-translate-y-0.5 hover:border-brand-lime hover:shadow-lg sm:p-7"
          >
            {post.publishedAt && (
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-400">
                <time datetime={post.publishedAt}>{formatDate(post.publishedAt, locale)}</time>
              </p>
            )}
            <h2 class="mt-3 font-display text-xl font-semibold leading-snug text-brand-black transition group-hover:text-brand-black/80 sm:text-2xl">
              {post.title}
            </h2>
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-500 sm:text-base">
              {post.excerpt || toExcerpt(post.body)}
            </p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-black">
              {t(locale, "cta.read_more")}
              <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
