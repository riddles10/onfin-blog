# ─────────────────────────────────────────────────────────────────────────────
# blog.onfin.io environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (used by docker compose) or `.env.local`
# (used by `next dev`) and fill in the values. Every runtime knob lives here
# so the same image can be promoted across environments without rebuilding.

# ── Site URL ──────────────────────────────────────────────────────────────────
# Public origin for canonical links, OG tags, sitemap, JSON-LD, and the cron
# worker's internal callback target. No trailing slash.
NEXT_PUBLIC_BASE_URL=https://blog.onfin.io

# ── Supabase (database + storage + auth) ──────────────────────────────────────
# Point these at a self-hosted Supabase stack or a managed one — the app does
# not care which, as long as the URLs and keys are valid.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-instance.example
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin auth (legacy single-password gate) ──────────────────────────────────
# The /admin route checks this against a session cookie set after the user
# enters the matching password. Keep it long and random.
ADMIN_PASSWORD=choose-a-strong-password

# ── Anthropic (AI content generation) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Tag Manager (analytics) ────────────────────────────────────────────
# Container id for blog.onfin.io (format GTM-XXXXXXX). When set, GTM loads with
# Consent Mode v2 wired to the cookie banner. Leave blank to ship no analytics
# (the site behaves exactly as it did before GTM was added).
NEXT_PUBLIC_GTM_ID=

# ── Slack notifications ───────────────────────────────────────────────────────
# Incoming webhook URL for the editorial channel. The cron pipeline posts
# Block Kit messages here when a draft lands and when generation fails.
# Leave blank to disable notifications.
SLACK_WEBHOOK_URL=

# ── Unsplash (cover images) ───────────────────────────────────────────────────
# Get a free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# ── Cron worker auth ──────────────────────────────────────────────────────────
# The cron-worker container POSTs to /api/cron/* with this in
# `Authorization: Bearer <secret>`. The same secret guards the routes inside
# the app. Set to a random string.
CRON_SECRET=your-random-cron-secret
