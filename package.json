{
  "name": "onfin-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "import:tilda": "tsx --env-file=.env.local scripts/import-tilda.ts",
    "build:fixture": "tsx --env-file=.env.local scripts/build-fixture.ts",
    "reclassify": "tsx --env-file=.env.local scripts/reclassify-posts.ts",
    "upload:covers": "tsx --env-file=.env.local scripts/upload-tilda-covers.ts",
    "translate:archive": "tsx --env-file=.env.local scripts/translate-archive.ts",
    "covers:unsplash": "tsx --env-file=.env.local scripts/fill-covers-unsplash.ts",
    "publish:schedule": "tsx --env-file=.env.local scripts/publish-schedule-posts.ts",
    "strip:emdashes": "tsx --env-file=.env.local scripts/strip-emdashes.ts",
    "improve:intros": "tsx --env-file=.env.local scripts/improve-intros.ts",
    "populate:also-read": "tsx --env-file=.env.local scripts/populate-also-read.ts",
    "cron:worker": "node scripts/cron-worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tiptap/extension-image": "^2.6.0",
    "@tiptap/extension-link": "^2.6.0",
    "@tiptap/extension-placeholder": "^2.6.0",
    "@tiptap/react": "^2.6.0",
    "@tiptap/starter-kit": "^2.6.0",
    "fast-xml-parser": "^4.5.0",
    "google-translate-api-x": "^10.7.2",
    "next": "^15.1.6",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
